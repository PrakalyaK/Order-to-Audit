# ============================================================================
# Order-to-Audit ERP — Environment Configuration Example
# Copy this file to backend/.env and configure with your local credentials
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Client URL (for CORS)
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=order_to_audit
DB_USER=postgres
DB_PASSWORD=postgres_secure_password_2026

# PostgreSQL Connection Pool Settings
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# JWT Authentication Settings (Min 32 characters)
JWT_SECRET=order_to_audit_jwt_secret_key_2026_super_secure_phase2
JWT_EXPIRES_IN=24h

# Password Hashing Settings
BCRYPT_SALT_ROUNDS=10

# Statutory & Tax Configuration (33 = Tamil Nadu GST Code)
FACTORY_STATE_CODE=33

# Demo Persona Switching (set to false in strict production)
ENABLE_DEMO_LOGIN=true
